# Optional: enables LLM-augmented detection via OpenRouter.
# Without this key, the engine runs in pure regex mode (fully functional).
OPENROUTER_API_KEY=your-key-here

# Optional: override the default LLM model. User selects model per project policy.
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: empirical tabular-model APIs. Keep real keys in .env, Fly secrets,
# or another secret manager. Never commit them.
TABPFN_API_KEY=your-tabpfn-key-here
XAI_API_KEY=your-xai-key-here
# Optional governed knowledge model for atomic guideline questions.
# GROK_MEDICAL_KNOWLEDGE_MODEL=grok-4.2
